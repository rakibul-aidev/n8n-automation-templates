{"name":"Team Standup Aggregator (Slack + Claude + Notion)","nodes":[{"parameters":{"rule":{"interval":[{"field":"cronExpression","expression":"0 9 * * 1-5"}]}},"id":"n1","name":"Weekdays 9 AM","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1,"position":[240,300]},{"parameters":{"channel":"#standup","limit":20},"id":"n2","name":"Fetch Standup Messages","type":"n8n-nodes-base.slack","typeVersion":2,"position":[460,300]},{"parameters":{"jsCode":"const msgs=($input.first().json.messages||[]).filter(function(m){return !m.bot_id&&m.text&&m.text.length>20;}).map(function(m){return m.text;}).join('\n---\n');return[{json:{updates:msgs,date:new Date().toLocaleDateString()}}];"},"id":"n3","name":"Aggregate Updates","type":"n8n-nodes-base.code","typeVersion":2,"position":[680,300]},{"parameters":{"modelId":"claude-3-5-haiku-20241022","messages":{"values":[{"role":"user","content":"=Summarize these standup updates from {{ $json.date }}:\n\n{{ $json.updates }}\n\nReturn JSON: {overall_summary:string, completed:string[], in_progress:string[], blockers:string[]}"}]}},"id":"n4","name":"Claude Summarize","type":"@n8n/n8n-nodes-langchain.lmChatAnthropic","typeVersion":1,"position":[900,300]},{"parameters":{"jsCode":"const s=JSON.parse($input.first().json.content[0].text);const date=$node.n3.json.date;return[{json:{...s,digest:'## Standup Digest — '+date+'\n\n**Summary:** '+s.overall_summary+'\n\n### Done\n'+s.completed.map(function(i){return'- '+i;}).join('\n')+'\n\n### In Progress\n'+s.in_progress.map(function(i){return'- '+i;}).join('\n')+'\n\n### Blockers\n'+(s.blockers.length?s.blockers.map(function(i){return'- '+i;}).join('\n'):'- None'),date:date}}];"},"id":"n5","name":"Format Digest","type":"n8n-nodes-base.code","typeVersion":2,"position":[1120,300]},{"parameters":{"channel":"#team-digest","text":"=📋 Standup Digest — {{ $json.date }}\n{{ $json.overall_summary }}"},"id":"n6","name":"Post to Slack","type":"n8n-nodes-base.slack","typeVersion":2,"position":[1340,200]}],"connections":{"Weekdays 9 AM":{"main":[[{"node":"Fetch Standup Messages","type":"main","index":0}]]},"Fetch Standup Messages":{"main":[[{"node":"Aggregate Updates","type":"main","index":0}]]},"Aggregate Updates":{"main":[[{"node":"Claude Summarize","type":"main","index":0}]]},"Claude Summarize":{"main":[[{"node":"Format Digest","type":"main","index":0}]]},"Format Digest":{"main":[[{"node":"Post to Slack","type":"main","index":0}]]}},"settings":{"executionOrder":"v1"}}