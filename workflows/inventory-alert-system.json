{"name":"Inventory Alert System (Shopify + Slack + Email)","nodes":[{"parameters":{"rule":{"interval":[{"field":"hours","hoursInterval":6}]}},"id":"n1","name":"Check Every 6 Hours","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1,"position":[240,300]},{"parameters":{"url":"https://YOUR_STORE.myshopify.com/admin/api/2024-01/products.json?limit=250","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","options":{}},"id":"n2","name":"Fetch Products","type":"n8n-nodes-base.httpRequest","typeVersion":4.1,"position":[460,300]},{"parameters":{"jsCode":"const products=$input.first().json.products;const LOW=5;const low=[];for(const p of products){for(const v of p.variants){if(v.inventory_quantity!==null&&v.inventory_quantity<=LOW){low.push({product_title:p.title,variant_title:v.title,sku:v.sku,inventory:v.inventory_quantity});}}}if(low.length===0)return[];return[{json:{low_stock_items:low,count:low.length,checked_at:new Date().toISOString()}}];"},"id":"n3","name":"Find Low Stock","type":"n8n-nodes-base.code","typeVersion":2,"position":[680,300]},{"parameters":{"conditions":{"number":[{"value1":"={{ $json.count }}","operation":"larger","value2":0}]}},"id":"n4","name":"Any Low Stock?","type":"n8n-nodes-base.if","typeVersion":1,"position":[900,300]},{"parameters":{"channel":"#inventory","text":"=⚠️ Low Stock: {{ $json.count }} items need restocking. Check dashboard."},"id":"n5","name":"Slack Alert","type":"n8n-nodes-base.slack","typeVersion":2,"position":[1120,200]},{"parameters":{"sendTo":"ops@yourcompany.com","subject":"=[ACTION] {{ $json.count }} low-stock items on Shopify","message":"=Low inventory as of {{ $json.checked_at }}:\n{{ $json.low_stock_items.map(function(i){return i.product_title+': '+i.inventory+' units (SKU: '+i.sku+')';}).join('\n') }}"},"id":"n6","name":"Email Ops","type":"n8n-nodes-base.gmail","typeVersion":2,"position":[1120,420]}],"connections":{"Check Every 6 Hours":{"main":[[{"node":"Fetch Products","type":"main","index":0}]]},"Fetch Products":{"main":[[{"node":"Find Low Stock","type":"main","index":0}]]},"Find Low Stock":{"main":[[{"node":"Any Low Stock?","type":"main","index":0}]]},"Any Low Stock?":{"main":[[{"node":"Slack Alert","type":"main","index":0},{"node":"Email Ops","type":"main","index":0}]]}},"settings":{"executionOrder":"v1"}}