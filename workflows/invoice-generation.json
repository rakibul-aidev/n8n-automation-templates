{"name":"Invoice Generation (Stripe + Google Sheets + Gmail)","nodes":[{"parameters":{"events":["invoice.payment_succeeded"]},"id":"n1","name":"Stripe Payment Webhook","type":"n8n-nodes-base.stripeTrigger","typeVersion":1,"position":[240,300]},{"parameters":{"jsCode":"const inv=$input.first().json.data.object;return[{json:{invoice_number:inv.number,customer_name:inv.customer_name,customer_email:inv.customer_email,amount_paid:(inv.amount_paid/100).toFixed(2),currency:inv.currency.toUpperCase(),invoice_pdf:inv.invoice_pdf,paid_at:new Date(inv.status_transitions.paid_at*1000).toISOString()}}];"},"id":"n2","name":"Extract Invoice Data","type":"n8n-nodes-base.code","typeVersion":2,"position":[460,300]},{"parameters":{"operation":"append","documentId":"YOUR_SHEET_ID","sheetName":"Invoices","columns":{"mappingMode":"defineBelow","value":{"Invoice":"={{ $json.invoice_number }}","Customer":"={{ $json.customer_name }}","Email":"={{ $json.customer_email }}","Amount":"={{ $json.amount_paid }}","Currency":"={{ $json.currency }}","Paid At":"={{ $json.paid_at }}"}}},"id":"n3","name":"Log to Google Sheets","type":"n8n-nodes-base.googleSheets","typeVersion":4,"position":[680,200]},{"parameters":{"sendTo":"={{ $json.customer_email }}","subject":"=Invoice #{{ $json.invoice_number }} — Payment received","message":"=Hi {{ $json.customer_name }},\n\nWe received your payment of {{ $json.currency }} ${{ $json.amount_paid }}.\n\nDownload invoice: {{ $json.invoice_pdf }}\n\nThank you for your business!"},"id":"n4","name":"Email Invoice","type":"n8n-nodes-base.gmail","typeVersion":2,"position":[680,420]}],"connections":{"Stripe Payment Webhook":{"main":[[{"node":"Extract Invoice Data","type":"main","index":0}]]},"Extract Invoice Data":{"main":[[{"node":"Log to Google Sheets","type":"main","index":0},{"node":"Email Invoice","type":"main","index":0}]]}},"settings":{"executionOrder":"v1"}}