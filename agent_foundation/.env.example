# === LLM APIs ===
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# === Database ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agent_foundation
POSTGRES_USER=agent
POSTGRES_PASSWORD=changeme

# === n8n ===
N8N_HOST=localhost
N8N_PORT=5678
N8N_WEBHOOK_SECRET=changeme
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme

# === Notifications / Human Handoff ===
SLACK_BOT_TOKEN=xoxb-...
SLACK_ESCALATION_CHANNEL=#ops-review
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=...
ESCALATION_EMAIL=ops@yourcompany.com

# === Agent Config ===
AGENT_LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR
AGENT_MAX_RETRIES=3
AGENT_RETRY_BASE_DELAY=2      # seconds, doubles each retry
AGENT_ESCALATION_TIMEOUT=3600 # seconds to wait for human response
AGENT_MEMORY_TTL_DAYS=90
